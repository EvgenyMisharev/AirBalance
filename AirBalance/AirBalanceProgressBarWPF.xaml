<Window x:Class="AirBalance.AirBalanceProgressBarWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AirBalance"
        mc:Ignorable="d"
        d:DesignHeight="100"
        d:DesignWidth="450"
        Title="Пространства обрабатываются. Нужно немного подождать..."
        MaxHeight="100"
        MaxWidth="450"
        MinHeight="100"
        MinWidth="450"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Icon="Resources/citrus.ico"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="{DynamicResource BaseFont}"
        FontSize="{DynamicResource FontSizeBase}"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Language="ru-RU">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitrusTheme/CitrusTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid ScrollViewer.CanContentScroll="True">
        <ProgressBar Name="pb_AirBalanceProgressBar" Margin="10" Value="0"/>
        <Label x:Name="label_ItemName" Content="" Margin="15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="10"/>
    </Grid>
</Window>
